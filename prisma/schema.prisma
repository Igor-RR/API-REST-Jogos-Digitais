generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = "file:./database.sqlite"
}

model Genero {
  id Int @id @default(autoincrement())
  nome String

  livros Livro[]
}

model Jogo {
  id Int @id @default(autoincrement())
  titulo String
  idGenero Int

  //Criando o Objeto
  genero Genero @relation(fields:[idGenero],references[id])

}

model Plataforma{
  id Int @id @default(autoincrement())
  nome String

  
}